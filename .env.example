# === Modus ===
# true  = paper (ingen ekte ordre, anbefalt først)
# false = live (sender limit-kjøp til Polymarket)
DRY_RUN=true

# === Polymarket-wallet (EGEN hot-wallet, aldri hovedkonto) ===
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
# 0 = MetaMask/Rabby EOA (anbefalt for bot)
# 1 = Polymarket e-post/Google (Magic proxy)
# 2 = Gnosis Safe / injisert nettleser-wallet
# 3 = ny Polymarket deposit-wallet (ERC-1271)
SIGNATURE_TYPE=0
CHAIN_ID=137

# Fylles etter: python -m agent.bootstrap_creds
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# === xAI / Grok (hjernen) ===
XAI_API_KEY=
GROK_MODEL=grok-4.6

# === Handelsregler (aggressiv edge-jakt) ===
MAX_POSITION_PCT=0.12
MIN_NET_EDGE=0.03
MODEL_HAIRCUT=0.02
KELLY_FRACTION=0.35
MAX_OPEN_POSITIONS=12
MAX_CATEGORY_PCT=0.40
DAILY_LOSS_HALT_PCT=0.06
WEEKLY_LOSS_HALT_PCT=0.15
MIN_LIQUIDITY_USD=3000
MIN_VOLUME_24H_USD=1000
MIN_BOOK_MULTIPLE=5
MAX_SPREAD=0.08
LOOP_SECONDS=180
ESTIMATE_BATCH=10

# Bankroll brukt i paper, og som fallback hvis live-balanse ikke leses
PAPER_BANKROLL_USD=1000

# Dashboard i nettleser (PC + mobil). På server: sett et langt hemmelig token.
DASHBOARD_PORT=8788
DASHBOARD_TOKEN=
