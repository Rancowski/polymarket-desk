# === Modus ===
# true  = paper (ingen ekte ordre, anbefalt først)
# false = live (sender limit-kjøp til Polymarket)
DRY_RUN=true

# === Polymarket-wallet (EGEN hot-wallet, aldri hovedkonto) ===
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
# 0 = MetaMask/Rabby EOA (anbefalt for bot)
# 1 = Polymarket e-post/Google (Magic proxy)
# 2 = Gnosis Safe / injisert nettleser-wallet
# 3 = ny Polymarket deposit-wallet (ERC-1271)
SIGNATURE_TYPE=0
CHAIN_ID=137

# Fylles etter: python -m agent.bootstrap_creds
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# === xAI / Grok (hjernen) ===
XAI_API_KEY=
GROK_MODEL=grok-4.6

# === Handelsregler (ikke rør før du har paper-data) ===
MAX_POSITION_PCT=0.06
MIN_NET_EDGE=0.08
MODEL_HAIRCUT=0.05
KELLY_FRACTION=0.25
MAX_OPEN_POSITIONS=10
MAX_CATEGORY_PCT=0.30
DAILY_LOSS_HALT_PCT=0.04
WEEKLY_LOSS_HALT_PCT=0.10
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_24H_USD=2000
MIN_BOOK_MULTIPLE=8
MAX_SPREAD=0.06
LOOP_SECONDS=900
ESTIMATE_BATCH=12

# Bankroll brukt i paper, og som fallback hvis live-balanse ikke leses
PAPER_BANKROLL_USD=1000
