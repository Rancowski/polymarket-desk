# === Freeze ===
# Buys only complement (both legs), kalshi only if |gap|-spread >= 0.10,
# partition only if the set is complete. maker off. locked off. Grok off in paper.
# DRY_RUN default true. DRY_RUN=false locks CLOB and does not trade.
DRY_RUN=true

# === Polymarket-wallet (EGEN hot-wallet, aldri hovedkonto) ===
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
# SIGNATURE_TYPE 1 or 3 for a Polymarket proxy (Magic/email or deposit wallet).
# 1 = Polymarket e-post/Google (Magic proxy)
# 3 = Polymarket deposit-wallet (ERC-1271)
SIGNATURE_TYPE=1
CHAIN_ID=137

# Fylles etter: python -m agent.bootstrap_creds
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# === xAI / Grok (off in paper; no client call while DRY_RUN=true) ===
XAI_API_KEY=
GROK_MODEL=grok-4.6

# === Paper buy halt (exits / redeem / paper_redeem still run) ===
MAX_POSITION_PCT=0.18
MIN_NET_EDGE=0.03
MODEL_HAIRCUT=0.02
KELLY_FRACTION=0.25
MAX_OPEN_POSITIONS=10
MAX_CATEGORY_PCT=0.40
DAILY_LOSS_HALT_PCT=0.06
WEEKLY_LOSS_HALT_PCT=0.15
MIN_LIQUIDITY_USD=3000
MIN_VOLUME_24H_USD=1000
MIN_BOOK_MULTIPLE=5
MAX_SPREAD=0.08
LOOP_SECONDS=300
CYCLE_SECONDS=300
ESTIMATE_BATCH=12
LIVE_SEARCH=false

# Bankroll brukt i paper, og som fallback hvis live-balanse ikke leses
PAPER_BANKROLL_USD=1000

# Dashboard i nettleser (PC + mobil). På server: sett et langt hemmelig token.
DASHBOARD_PORT=8788
DASHBOARD_TOKEN=

# Valgfritt: hva du har kjøpt av xAI-kreditter, så dashboard viser «igjen»
XAI_PREPAID_USD=
